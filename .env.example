# Copy to .env and fill in. Every value has a working default except GROQ_API_KEY.

# --- generation ---------------------------------------------------------------
# "ollama" runs llama3 on this machine (free, private, but it will heat a laptop).
# "groq" runs a llama-3 model on Groq's free tier (nothing runs locally).
LOREMIND_LLM_PROVIDER=ollama

# groq: get a free key at https://console.groq.com/keys
GROQ_API_KEY=
LOREMIND_GROQ_MODEL=llama-3.3-70b-versatile

# ollama
LOREMIND_OLLAMA_MODEL=llama3
LOREMIND_OLLAMA_HOST=http://localhost:11434

# --- vector store ------------------------------------------------------------
# Leave empty for embedded mode: qdrant runs in-process, no server, no cost.
# Set to e.g. http://localhost:6333 to use a Qdrant server instead.
LOREMIND_QDRANT_URL=
LOREMIND_QDRANT_API_KEY=

# --- api ---------------------------------------------------------------------
# Lock this down to your own origin before exposing the app publicly.
LOREMIND_CORS_ORIGINS=*
LOREMIND_MAX_QUERY_CHARS=400
LOREMIND_MAX_CONCURRENT=4

# --- retrieval tuning --------------------------------------------------------
# Below this cross-encoder score the corpus is treated as having no answer and
# no generation call is made. See calibrate.py before changing it.
LOREMIND_GROUNDING_MIN_SCORE=-2.0
